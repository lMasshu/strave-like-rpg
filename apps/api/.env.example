# Copier en .env (jamais commité) puis adapter.

# Base PostgreSQL/PostGIS (docker compose -f infrastructure/docker-compose.yml up -d).
# Sans cette variable, l'API garde comptes et activités en mémoire.
DATABASE_URL=postgres://stride:stride_dev@localhost:5432/stride_quest

# Secret de signature des sessions : 32 caractères minimum, aléatoire.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Connexion Google via Auth0 (mêmes valeurs que VITE_AUTH0_DOMAIN / VITE_AUTH0_CLIENT_ID côté mobile).
# Laisser vide pour désactiver le bouton Google côté serveur.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Moteur IA souverain local (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b
